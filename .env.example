# Target allowlist (comma-separated). Only these hosts may be scanned.
ALLOWLIST=localhost,127.0.0.1,juice-shop.local,*.modal.run,*.modal.host,*.trycloudflare.com

# Optional: LLM for agent reasoning (falls back to rule-based planner)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Supabase audit log (falls back to local JSONL)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Ossprey — supply-chain malware scanning (https://dashboard.ossprey.com)
OSSPREY_API_KEY=
OSSPREY_API_URL=https://api.ossprey.com

# Overmind — infra blast radius (https://app.overmind.tech)
# Also used by Overmind MCP at https://api.overmind.tech/api/mcp
OVM_API_KEY=
OVERMIND_API_KEY=
OVERMIND_API_URL=https://api.overmind.tech

# Agent API
AGENT_HOST=0.0.0.0
AGENT_PORT=8787
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Demo sandbox URL (set after Modal deploy or local docker)
SANDBOX_URL=http://127.0.0.1:3001